CLUSTER_USER=clusteradmin
CLUSTER_USER_PASSWORD=cladmin

CLUSTER_SECERT=-u${CLUSTER_USER} -p${CLUSTER_USER_PASSWORD}

MYSQL_ADMIN=admin
MYSQL_ADMIN_PASSWORD=Abcd1234

ADMIN_SECERT=-u${MYSQL_ADMIN} -p${MYSQL_ADMIN_PASSWORD}

MYSQL_ROUTER_IMAGE=container-registry.oracle.com/mysql/community-router:8.4.1
MYSQL_HOST=$(shell hostname -f)
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=Abcd1234
MYSQL_ROOT_PASSWORD=Abcd1234
MYSQL_INNODB_CLUSTER_MEMBERS=3
TZ=Asia/Shanghai

SQL_PATH=../sql

export CLUSTER_USER
export CLUSTER_USER_PASSWORD
export CLUSTER_SECERT
export MYSQL_ADMIN
export MYSQL_ADMIN_PASSWORD
export ADMIN_SECERT
export MYSQL_ROUTER_IMAGE
export MYSQL_HOST
export MYSQL_PORT
export MYSQL_USER
export MYSQL_PASSWORD
export MYSQL_ROOT_PASSWORD
export MYSQL_INNODB_CLUSTER_MEMBERS
export SQL_PATH
export TZ